
# KI-Backend: "mock" (regelbasiert, offline) oder "openai" (echte API).
AI_BACKEND=openai

# Basis-URL der OpenAI-kompatiblen API (inkl. API-Praefix der Client haengt
# nur noch /chat/completions an).
#   echtes OpenAI:        https://api.openai.com/v1
#   Open WebUI:           http://<open-webui-host>/api     (kein /v1!)
OPENAI_BASE_URL=https://api.openai.com/v1

# Modell. OpenAI z. B. gpt-4o-mini Open WebUI z. B. qwen3-coder:30b
# (exakten Namen in Open WebUI unter Modelle nachsehen).
OPENAI_MODEL=gpt-4o-mini

# API-Key. OpenAI: beginnt mit sk-... / Open WebUI: unter
# Einstellungen > Konto > API-Schluessel erzeugen. NIEMALS committen!
OPENAI_API_KEY=DEINEN-KEY-HIER-EINTRAGEN
